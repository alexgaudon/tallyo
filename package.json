{
	"name": "tallyo-rewrite",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "vp check --fix",
		"prepare": "vp config",
		"dev": "vp run --filter web --filter server --parallel dev",
		"build": "vp run --filter web --filter server --cache build",
		"check-types": "rm -rf apps/server/dist apps/web/tsconfig.tsbuildinfo && vp run --filter server build && vp run --filter web --filter server check-types",
		"test": "vp run --filter web --filter server test",
		"dev:web": "vp run --filter web dev",
		"dev:server": "vp run --filter server dev",
		"db:push": "vp run --filter server db:push",
		"db:studio": "vp run --filter server db:studio",
		"db:generate": "vp run --filter server db:generate",
		"db:migrate": "vp run --filter server db:migrate",
		"db:dev": "docker compose up -d postgres",
		"db:dev:attached": "docker compose up postgres",
		"db:down": "docker compose down",
		"db:seed": "vp run --filter server db:seed",
		"db:refresh": "vp run --filter server db:refresh"
	},
	"dependencies": {
		"@tanstack/react-hotkeys": "^0.10.0"
	},
	"devDependencies": {
		"vite-plus": "1.0.0"
	},
	"overrides": {
		"diff": "8.0.3",
		"esbuild": "^0.28.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"packageManager": "npm@10.8.2"
}
