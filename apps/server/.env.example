# Application origin (must match the web app URL)
CORS_ORIGIN=http://localhost:3001

# Required Discord OAuth credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: defaults to ${CORS_ORIGIN}/api/auth/callback/discord
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional: enables AI category suggestions via Jev on OpenRouter.
# When set, transactions without a category get an AI-suggested category
# stored as metadata (never auto-applied).
# OPENROUTER_API_KEY=
# Optional: Jev model id (default: typesafe/jev-1.13)
# JEV_MODEL=typesafe/jev-1.13
# Optional: minimum confidence for storing a suggestion (default: 0.7)
# JEV_CONFIDENCE_THRESHOLD=0.7
