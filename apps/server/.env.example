# Application origin (must match the web app URL)
CORS_ORIGIN=http://localhost:3001

# Required Discord OAuth credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: defaults to ${CORS_ORIGIN}/api/auth/callback/discord
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional: enables AI category suggestions (Jev) via OpenRouter. When set,
# transactions without a category are queued for an AI suggestion, stored as
# metadata (suggestedCategoryId / suggestedCategoryConfidence) and offered in
# the UI — never auto-applied.
# OPENROUTER_API_KEY=
# Optional: Jev model slug (default: typesafe/jev-1.13)
# JEV_MODEL=typesafe/jev-1.13
# Optional: minimum confidence to keep a suggestion (default: 0.7)
# JEV_CONFIDENCE_THRESHOLD=0.7

# Development only: GET /api/auth/dev-login signs you in without Discord. It
# reuses the first existing user (so local data is visible) or creates a fixed
# test user; add ?fresh=1 to force the test user. In production the route
# returns 404. Override the test user's identity with:
# DEV_LOGIN_NAME=Dev User
# DEV_LOGIN_EMAIL=dev@tallyo.local
